<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="theme-color" content="<%= meta.theme %>">
        <title><%= meta.title %></title>
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <link rel="icon" href="<%= meta.favicon %>">
        <link rel="apple-touch-icon" href="<%= meta.favicon %>">
        <% for tag in htmlRspackPlugin.tags.headTags { %>
          <% if tag.tagName == "link" { %>
            <%= toHtml(tag) %>
          <% } %>
        <% } %>
    </head>
    <body>
        <header>
            <div class="bar">
                <a href="/" class="title" title="Go to main page"><%= meta.name %></a>
            </div>
        </header>
        <main>
            <div class="init-blk">
                <div class="message">
                    <div class="title">404</div>
                    <div class="body">Page not found</div>
                </div>
            </div>
        </main>
    </body>
</html>
